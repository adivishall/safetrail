# Language statistics. GitHub counts bytes, so generated output and input data
# (the OSM road extract alone is ~5 MB) would otherwise outweigh the C++ and
# label the repository by whatever is largest. They are not authored source.
data/**            linguist-generated=true
bench/results/**   linguist-generated=true
bench/plots/**     linguist-generated=true
web/**             linguist-generated=true
docs/**            linguist-documentation=true
*.pdf              linguist-generated=true
*.pptx             linguist-generated=true

*.cpp              linguist-language=C++
*.hpp              linguist-language=C++
